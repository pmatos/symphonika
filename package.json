{
  "name": "symphonika",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "bin": {
    "symphonika": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "npm run build:client && tsx src/cli.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "gen:fonts": "node scripts/gen-fonts.mjs",
    "fuzz:workflow": "npm run build && jazzer --sync fuzz/workflow-parse.fuzz.mjs -- -max_total_time=30",
    "fuzz:workflow:dry": "npm run build && jazzer --sync --dryRun fuzz/workflow-parse.fuzz.mjs -- -runs=1",
    "knip": "knip",
    "lint": "eslint .",
    "mutation": "stryker run",
    "mutation:dry": "stryker run --dryRunOnly",
    "prepare": "npm run build",
    "quality": "npm run lint && npm run typecheck && npm test && npm run build",
    "smoke": "tsx src/cli.ts smoke",
    "smoke:local": "scripts/smoke.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck:server && npm run typecheck:client && npm run typecheck:client-tests",
    "typecheck:client": "tsc --noEmit -p src/client/tsconfig.json",
    "typecheck:client-tests": "tsc --noEmit -p tests/client/tsconfig.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@octokit/rest": "^22.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "cron-parser": "^5.10.0",
    "cytoscape": "^3.34.1",
    "hono": "^4.13.3",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jazzer.js/core": "^4.0.0",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.2",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
